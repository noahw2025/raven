# Publish only the RAVEN application and its pinned Hermes dependency.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/README.md
!/outputs/
/outputs/*
!/outputs/raven/
!/work/
/work/*
!/work/hermes-agent/

# Credentials, private state, model downloads, build caches and local tooling.
**/.env
**/.env.*
!**/.env.example
**/*credentials*.json
**/*token*.json
**/*.pem
**/*.key
**/.runtime/
**/data/
**/logs/
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/venv/
**/node_modules/
**/*.pyc
**/*.log
**/*.sqlite*
**/*.db
**/*.safetensors
**/*.gguf
**/*.onnx
**/*.pt
**/*.pth
**/*.zip
**/*.7z
**/test-results/
**/playwright-report/
outputs/raven/tests/*.png
outputs/raven/tests/*.webm
outputs/raven/tests/*.wav
outputs/raven/tests/*.mp4
outputs/raven/comfyui/acceptance/
