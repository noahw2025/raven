# Copy to .env and set fresh secrets there. This blank template is safe to commit; .env is not.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional hosted research fallback. This secret remains server-side.
NVIDIA_API_KEY=
NVIDIA_RESEARCH_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
FORGE_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
FORGE_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
FORGE_LOCAL_MODEL=qwen3:8b
RAVEN_ADMIN_PASSWORD=
RAVEN_JWT_SECRET=
RAVEN_REQUIRE_LOGIN=false
POSTGRES_PASSWORD=
AI_PROVIDER=ollama
RAVEN_MODEL=qwen3:8b
RAVEN_VOICE_MODEL=qwen3:8b
STT_PRIMARY_MODEL=large-v3-turbo
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_FALLBACK_MODEL=base.en
PARAKEET_MODEL=nvidia/parakeet_realtime_eou_120m-v1
PARAKEET_DEVICE=cuda
RAVEN_EMBEDDING_MODEL=nomic-embed-text
RAVEN_REALTIME_MODEL=gpt-realtime-mini
RAVEN_REALTIME_VOICE=marin
RAVEN_MAX_CONTEXT_CHUNKS=6
RAVEN_MAX_CONTEXT_CHARS=12000
RAVEN_PUBLIC_ORIGIN=http://localhost:8080
HERMES_URL=
HERMES_TOKEN=
# Server-side JSON only. Each entry accepts url, optional header_env,
# header_name, and header_prefix. Secrets belong in separate environment vars.
HERMES_MCP_SERVERS_JSON={}
HERMES_MCP_AUTH_TOKEN=
CONTENT_TEXT_PROVIDER=active
CONTENT_TEXT_MODEL=qwen3:8b
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
RAVEN_RESEARCH_PROVIDER=auto
RAVEN_RESEARCH_MODEL=gpt-5.6-terra
RAVEN_RESEARCH_BUDGET_USD=0.25
COMFYUI_URL=
COMFYUI_WORKFLOW_PATH=/config/comfyui-workflow.json
COMFYUI_PROMPT_NODE_ID=6
COMFYUI_PROMPT_INPUT=text
COMFYUI_IMAGE_WORKFLOW_PATH=/config/comfyui-image-workflow.json
COMFYUI_IMAGE_PROMPT_NODE_ID=6
COMFYUI_VIDEO_WORKFLOW_PATH=/config/comfyui-video-workflow.json
COMFYUI_VIDEO_PROMPT_NODE_ID=6
# Instagram secrets stay here on the server and are never returned to the UI.
INSTAGRAM_API_BASE=https://graph.instagram.com
INSTAGRAM_API_VERSION=v24.0
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PUBLISH_ENABLED=false
X_ACCESS_TOKEN=
X_PUBLISH_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PUBLISH_ENABLED=false
CAREER_APPLY_URL=
CAREER_APPLY_TOKEN=
CAREER_APPLY_ENABLED=false
# Windows host companion. Use the same 32+ character value as RAVEN_DESKTOP_BRIDGE_TOKEN on the host.
DESKTOP_BRIDGE_URL=http://host.docker.internal:8765
DESKTOP_BRIDGE_TOKEN=
DESKTOP_BRIDGE_ENABLED=false
# JSON object of spoken aliases to Discord guild/channel IDs. Keep IDs server-side.
DISCORD_CHANNELS_JSON={}
# Playback needs Spotify Premium, OAuth user-modify-playback-state, and an active device.
# Without these values RAVEN can still open Spotify and an exact song search.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_PLAYBACK_ENABLED=false
SPOTIFY_MARKET=US
RAVEN_TIMEZONE=America/New_York
RAVEN_OWNER_NAME=Noah
# Optional World providers. Keys stay server-side; the public layers need no key.
WORLD_AISSTREAM_API_KEY=
WORLD_LL2_TOKEN=
